{
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3"
  },
  "scripts": {
    "dev": "node scripts/build-css.mjs && node node_modules/vite/bin/vite.js --base ./",
